# SmileCraft Dental — Production Environment Variables Reference
# Copy to .env.local for local overrides. NEVER commit secrets or .env.local to Git.

# Primary site canonical URL for production (Netlify or custom domain)
VITE_SITE_URL="https://smilecraftdental.netlify.app"

# Optional: Google Maps Embed URL for a real clinic location replacement
VITE_GOOGLE_MAPS_EMBED_URL=""

# Optional: Google Analytics 4 Measurement ID (leave empty if not using GA)
VITE_GA_MEASUREMENT_ID=""

# Platform defaults
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
